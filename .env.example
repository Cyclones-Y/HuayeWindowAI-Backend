APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true

# 本机服务默认使用 3306/6379；Compose 容器会覆盖为内部服务名。
DATABASE_URL=mysql+asyncmy://huaye:replace_me@127.0.0.1:3306/huaye_window_ai?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

WECHAT_APP_ID=wx_replace_me
WECHAT_APP_SECRET=replace_me

# 分别生成两个 32 字节随机值并做 Base64 编码，严禁在不同用途间复用。
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
PHONE_ENCRYPTION_KEY_B64=replace_with_32_byte_base64_key
PHONE_LOOKUP_HMAC_KEY_B64=replace_with_another_32_byte_base64_key
PHONE_KEY_VERSION=1

SESSION_TTL_SECONDS=7200
LOGIN_IP_LIMIT_PER_MINUTE=30
LOGIN_DEVICE_LIMIT_PER_MINUTE=10
WECHAT_HTTP_TIMEOUT_SECONDS=5

# Compose 专用变量；仅开发环境使用，生产环境请使用密钥管理系统。
MYSQL_DATABASE=huaye_window_ai
MYSQL_USER=huaye
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_root_password
