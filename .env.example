# ==================== 应用配置 ====================
APP_ENV=development
APP_NAME=华业门窗 AI 小程序后端
APP_VERSION=0.1.0

# 所有业务接口（含微信登录）的统一前缀；修改后重启服务，例如 /api/v1。
API_PREFIX=/v1

# 真机联调使用 0.0.0.0；仅本机访问可改为 127.0.0.1。
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DOCS_ENABLED=true
# 启动时检查 MySQL 和 Redis，并把结果打印到启动日志。
APP_STARTUP_CHECKS_ENABLED=true

# 客户端能够访问的地址，不包含 API_PREFIX；真机请使用局域网地址，生产必须 HTTPS。
API_PUBLIC_BASE_URL=http://127.0.0.1:8000
# 留空时使用 API_PUBLIC_BASE_URL/catalog；也可填写部署了相同目录图片的 CDN 地址。
CATALOG_PUBLIC_BASE_URL=

# ==================== 照片与私有存储 ====================
# local 用于本地联调或共享持久磁盘部署；s3 对接私有 S3 兼容 Bucket。
PHOTO_STORAGE_BACKEND=local
PHOTO_LOCAL_DIRECTORY=data/photos
PHOTO_MAX_BYTES=10485760
PHOTO_MAX_PIXELS=40000000
PHOTO_THUMBNAIL_MAX_EDGE=512
PHOTO_PREVIEW_TTL_SECONDS=3600
# 开发留空会使用进程随机密钥（重启后旧链接失效）；生产 local 必须设置至少 32 字符随机密钥。
PHOTO_URL_SIGNING_KEY=
# S3 模式必填 Bucket；endpoint/region 留空使用 SDK 默认设置。
PHOTO_S3_BUCKET=
# PHOTO_S3_ENDPOINT_URL=https://s3.example.com
# PHOTO_S3_REGION=region-name
# 凭据成对配置；都留空时使用 SDK 的角色/环境凭据链。不要提交真实密钥。
PHOTO_S3_ACCESS_KEY_ID=
PHOTO_S3_SECRET_ACCESS_KEY=

# ==================== 日志配置 ====================
APP_LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=true
# 控制台推荐 plain 便于开发阅读，生产日志采集可改为 json。
LOG_CONSOLE_FORMAT=plain
LOG_FILE_ENABLED=true
LOG_FILE_FORMAT=json
LOG_DIRECTORY=logs
# Loguru 滚动、保留和压缩规则，语法与 RuoYi-Vue3-FastAPI 保持一致。
LOG_ROTATION=50 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=zip
LOG_INSTANCE_ID=default
LOG_ACCESS_ENABLED=true

# ==================== MySQL 配置 ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=huaye
DB_PASSWORD=replace_me
DB_DATABASE=huaye_window_ai
# 开启后 SQLAlchemy 会输出 SQL，仅建议临时排查问题时使用。
DB_ECHO=false
# 高级部署场景可用完整 DSN 覆盖上述 DB_* 配置：
# DATABASE_URL=mysql+asyncmy://huaye:replace_me@127.0.0.1:3306/huaye_window_ai?charset=utf8mb4

# ==================== Redis 配置 ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
# 高级部署场景可用完整 URL 覆盖上述 REDIS_* 配置：
# REDIS_URL=redis://127.0.0.1:6379/0

# ==================== 微信小程序配置 ====================
WECHAT_APP_ID=wx_replace_me
WECHAT_APP_SECRET=replace_me
WECHAT_HTTP_TIMEOUT_SECONDS=5

# ==================== 登录与会话配置 ====================
SESSION_TTL_SECONDS=7200
LOGIN_IP_LIMIT_PER_MINUTE=30
LOGIN_DEVICE_LIMIT_PER_MINUTE=10

# ==================== Compose 专用配置 ====================
# 仅供 compose.yaml 初始化容器，不被 FastAPI 直接读取。
MYSQL_DATABASE=huaye_window_ai
MYSQL_USER=huaye
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_root_password

# ==================== Seedream 真实生成（默认关闭） ====================
# 密钥仅配置在后端；具备模型访问权限后再启用，真实调用会产生供应商费用。
RENDER_ENABLED=true
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
RENDER_WORKER_CONCURRENCY=2
RENDER_PROVIDER_TIMEOUT_SECONDS=300
RENDER_TASK_TIMEOUT_SECONDS=420
# 排队最长等待15分钟，超时后可显式重试/清理，不自动调用模型。
RENDER_QUEUE_MAX_WAIT_SECONDS=900
RENDER_MAINTENANCE_INTERVAL_SECONDS=5
# 心跳TTL必须大于间隔，/health/ready据此报告worker离线。
RENDER_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
RENDER_WORKER_HEARTBEAT_TTL_SECONDS=20
